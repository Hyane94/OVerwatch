/* ---------- données dérivées ---------- */
function slug(s){return s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9]+/g,"-").replace(/^-|-$/g,"");}
var HEROES = H.map(function(r){
  var comps = {};
  r[3].split(" ").forEach(function(tok){
    var p = tok.split(":"), q = /\?$/.test(p[1]);
    comps[p[0]] = {lvl:parseInt(p[1],10), q:q};
  });
  var utils = {};
  Object.keys(r[5]).forEach(function(k){
    var v = r[5][k], q = v.charAt(0)==="?";
    utils[k] = {why:q?v.slice(1):v, q:q};
  });
  return {id:slug(r[0]), nom:r[0], role:r[1], sous:r[2], comps:comps, desc:r[4], utils:utils};
});
var BY_ID = {}; HEROES.forEach(function(h){BY_ID[h.id]=h;});
var BY_NAME = {}; HEROES.forEach(function(h){BY_NAME[h.nom]=h;});
function byName(a,b){return a.nom.localeCompare(b.nom,"fr");}

function chip(h,lvl,q){
  return '<button type="button" class="chip r-'+h.role+(lvl===2?' l2':'')+'" data-hero="'+h.id+'">'+h.nom+(q?'<span class="qm" title="Placement à confirmer">?</span>':'')+'</button>';
}
function chipsFor(compId){
  var out = {tank:[],dgt:[],sup:[]};
  HEROES.forEach(function(h){ if(h.comps[compId]){ out[h.role].push({h:h,lvl:h.comps[compId].lvl,q:h.comps[compId].q}); }});
  Object.keys(out).forEach(function(k){ out[k].sort(function(a,b){return a.lvl-b.lvl || byName(a.h,b.h);}); });
  return out;
}
function roleCols(data){
  return '<div class="cols3">'+["tank","dgt","sup"].map(function(r){
    var list = data[r];
    return '<div class="rolecol"><div class="rolebar display r-'+r+'">'+ROLES[r]+'</div><div class="rolebody">'+
      (list.length ? list.map(function(x){return chip(x.h,x.lvl,x.q);}).join("") : '<p class="none">Aucun héros</p>')+'</div></div>';
  }).join("")+'</div>';
}
function bullets(arr){
  return '<ul>'+arr.map(function(b){return '<li>'+b[0]+(b[1]?'<span class="inf" title="Déduction, pas une source">◇</span>':'')+'</li>';}).join("")+'</ul>';
}

