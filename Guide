  var html = "", n = 0;
  var cols = ["tank","dgt","sup"].filter(function(r){return roleFilter==="all"||roleFilter===r;});
  cols.forEach(function(r){
    var block = "";
    SOUS[r].forEach(function(s){
      var list = HEROES.filter(function(h){
        return h.role===r && h.sous===s && (!query || norm(h.nom).indexOf(norm(query))>-1);
      }).sort(byName);
      if(!list.length) return;
      n += list.length;
      block += '<h4 class="sub display">'+(SOUS_LABEL[s]||s)+(PASSIFS[s]?'<small>'+PASSIFS[s]+'</small>':'')+'</h4>'+list.map(function(h){return chip(h,1,false);}).join("");
    });
    if(block) html += '<h3 class="urole display r-'+r+'">'+ROLES[r]+'</h3>'+block;
  });
  document.getElementById("all-heroes").innerHTML = n ? html : '<p class="none">Aucun héros ne correspond à cette recherche.</p>';
}

/* ---------- fiche héros ---------- */
var COMP_NAME = {}; COMPS.forEach(function(c){COMP_NAME[c.id]=c.nom;});
var UTIL_NAME = {}; UTILS.forEach(function(u){UTIL_NAME[u.id]=u.nom;});
function openHero(id){
  var h = BY_ID[id]; if(!h) return;
  var passif = PASSIFS[h.sous];
  var comps = Object.keys(h.comps).sort(function(a,b){return h.comps[a].lvl-h.comps[b].lvl;}).map(function(k){
    var c = h.comps[k];
    return '<li>'+COMP_NAME[k]+(c.lvl===1?' (principal)':' (peut aussi)')+(c.q?' <span class="qm">?</span>':'')+'</li>';
  }).join("");
  var utils = Object.keys(h.utils).map(function(k){
    var u = h.utils[k];
    return '<li><b>'+UTIL_NAME[k]+'</b>'+(u.q?' <span class="qm">?</span>':'')+' : '+u.why+'</li>';
  }).join("");
  document.getElementById("hd-body").innerHTML =
    '<h2 class="display r-'+h.role+'" id="hd-title" style="color:var(--c)">'+h.nom+'</h2>'+
    '<div class="meta">'+ROLES[h.role]+', sous-rôle '+(SOUS_LABEL[h.sous]||h.sous)+(passif?'. '+passif:'')+'</div>'+
    '<p>'+h.desc+'</p>'+
    '<h3 class="display">Compos</h3><ul>'+comps+'</ul>'+
    (utils?'<h3 class="display">Utilités</h3><ul>'+utils+'</ul>':'')+
    '<button type="button" class="close" data-close="1">Fermer</button>';
  var d = document.getElementById("hd");
  if(typeof d.showModal === "function"){ d.showModal(); } else { d.setAttribute("open",""); }
}

/* ---------- événements ---------- */
document.addEventListener("click",function(e){
  var t = e.target;
  var hero = t.closest("[data-hero]"); if(hero){ openHero(hero.getAttribute("data-hero")); return; }
  if(t.closest("[data-close]")){ document.getElementById("hd").close(); return; }
  var dlg = document.getElementById("hd");
  if(t===dlg){ dlg.close(); return; }
  var tab = t.closest("[data-tab]");
  if(tab){
    document.querySelectorAll(".tab").forEach(function(b){b.setAttribute("aria-selected", b===tab ? "true":"false");});
    ["compos","utils","matrix","heros"].forEach(function(k){document.getElementById("s-"+k).hidden = (k!==tab.getAttribute("data-tab"));});
    return;
  }
  var cp = t.closest("[data-comp]");
  if(cp){ curComp = cp.getAttribute("data-comp"); renderPick(); renderComp(); return; }
  var up = t.closest("[data-util]");
  if(up){ curUtil = up.getAttribute("data-util"); renderUtilPick(); renderUtil(); return; }
  var rf = t.closest("[data-role]");
  if(rf){ roleFilter = rf.getAttribute("data-role"); document.querySelectorAll(".rf").forEach(function(b){b.setAttribute("aria-pressed", b===rf ? "true":"false");}); renderAll(); return; }
});
document.getElementById("q").addEventListener("input",function(e){ query = e.target.value.trim(); renderAll(); });

renderPick(); renderComp(); renderUtilPick(); renderUtil(); renderMatrix(); renderAll();
})();
</script>
