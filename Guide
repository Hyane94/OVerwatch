/* ---------- schémas ---------- */
function marker(id){return '<marker id="'+id+'" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0L10 5L0 10z" class="ah"/></marker>';}
function circ(x,y,c){return '<circle class="'+c+'" cx="'+x+'" cy="'+y+'" r="7"/>';}
function dia(id,uid,title){
  var m='m-'+uid, s='', ally=function(a){return a.map(function(p){return circ(p[0],p[1],'a');}).join('');}, foe=function(a){return a.map(function(p){return circ(p[0],p[1],'f');}).join('');};
  if(id==='poke'){
    s=ally([[28,22],[42,55],[28,88]])+foe([[198,46],[210,60],[198,74]])+
      '<path class="ln dash" d="M40 24 L184 50" marker-end="url(#'+m+')"/><path class="ln dash" d="M54 56 L184 60" marker-end="url(#'+m+')"/><path class="ln dash" d="M40 86 L184 72" marker-end="url(#'+m+')"/>';
  } else if(id==='dive'){
    s=ally([[30,40],[30,70],[48,55]])+foe([[150,35],[150,55],[150,75],[212,55]])+
      '<path class="ln" d="M56 50 Q132 -8 202 50" marker-end="url(#'+m+')"/>';
  } else if(id==='brawl'){
    s=ally([[96,40],[104,58],[96,76]])+foe([[136,40],[144,58],[136,76]])+
      '<path class="ln thick" d="M20 58 L80 58" marker-end="url(#'+m+')"/><path class="ln thick" d="M220 58 L160 58" marker-end="url(#'+m+')" opacity=".35"/>';
  } else if(id==='rush'){
    s=ally([[28,40],[36,58],[28,76]])+foe([[198,46],[208,60],[198,74]])+
      '<path class="ln thick" d="M54 58 L176 58" marker-end="url(#'+m+')"/><path class="ln" d="M60 38 L120 38"/><path class="ln" d="M60 78 L120 78"/><path class="ln" d="M70 28 L100 28"/><path class="ln" d="M70 88 L100 88"/>';
  } else if(id==='turtle'){
    s=ally([[24,40],[30,58],[24,76]])+foe([[200,40],[208,58],[200,76]])+
      '<path class="arc" d="M82 18 Q112 58 82 98"/><rect class="sq" x="52" y="30" width="12" height="12" rx="2"/><rect class="sq" x="52" y="74" width="12" height="12" rx="2"/>'+
      '<path class="ln dash" d="M188 42 L120 52" marker-end="url(#'+m+')"/><path class="ln dash" d="M188 76 L120 64" marker-end="url(#'+m+')"/>';
  } else {
    s=ally([[40,42],[48,58],[40,74]])+foe([[168,42],[178,58],[168,74],[212,50]])+
      '<path class="ln dash" d="M62 58 L150 58" marker-end="url(#'+m+')"/>'+circ(36,98,'a')+
      '<path class="ln" d="M50 100 Q150 118 224 92 Q238 76 216 66" marker-end="url(#'+m+')"/>';
  }
  return '<svg class="dia" viewBox="0 0 240 110" role="img" aria-label="'+title+'"><defs>'+marker(m)+'</defs>'+s+'</svg>';
}
