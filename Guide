var curComp = "brawl", curUtil = "assassin";
function renderPick(){
  document.getElementById("comp-pick").innerHTML = COMPS.map(function(c){
    return '<button type="button" class="cp" data-comp="'+c.id+'" aria-pressed="'+(c.id===curComp)+'">'+dia(c.id,c.id+"-p",DIA_TITLE[c.id])+'<span class="nm display">'+c.nom+'</span></button>';
  }).join("");
}
function teamHtml(c){
  if(!c.equipes.length){ return '<div class="teams"><h3 class="display">Équipe type</h3><p class="none">'+c.noteTeam+'</p></div>'; }
  return '<div class="teams"><h3 class="display">Équipes types</h3>'+c.equipes.map(function(t){
    var all = [].concat(t.tank,t.dgt,t.sup).map(function(n){var h=BY_NAME[n];return chip(h,1,false);}).join("");
    return '<div class="team"><div class="tt">'+t.t+'</div>'+all+'</div>';
  }).join("")+'</div>';
}
function renderComp(){
  var c = COMPS.filter(function(x){return x.id===curComp;})[0];
  var html = '<div class="phead">'+dia(c.id,c.id+"-b",DIA_TITLE[c.id])+'<div><h2 class="display">'+c.nom+'</h2><p>'+c.def+'</p></div></div>'+
    roleCols(chipsFor(c.id))+
    '<div class="cols2"><div class="box good"><h3 class="display">Ce qui est fort</h3>'+bullets(c.forts)+'</div>'+
    '<div class="box bad"><h3 class="display">Ce qui est faible</h3>'+bullets(c.faibles)+'</div>'+
    '<div class="box play"><h3 class="display">Comment la jouer</h3>'+bullets(c.jouer)+'</div>'+
    '<div class="box counter"><h3 class="display">Comment la contrer</h3>'+bullets(c.contrer)+'</div></div>'+
    teamHtml(c)+
    '<p class="src">'+(c.src ? 'Sources : guides <a href="https://mobalytics.gg/overwatch/guides/poke-team-comp" target="_blank" rel="noopener">Mobalytics</a> sur le poke et le dive, qui décrivent aussi le rush et le brawl. Les points marqués ◇ sont des déductions.' : 'Pas de guide de référence trouvé pour cette compo : les textes sont des déductions à confirmer.')+'</p>';
  document.getElementById("comp-panel").innerHTML = html;
}

/* ---------- rendu : utilités ---------- */
function renderUtilPick(){
  document.getElementById("util-pick").innerHTML = UTILS.map(function(u){
    return '<button type="button" class="up" data-util="'+u.id+'" aria-pressed="'+(u.id===curUtil)+'">'+u.nom+'</button>';
  }).join("");
}
function renderUtil(){
  var u = UTILS.filter(function(x){return x.id===curUtil;})[0];
  var html = '<p class="udef">'+u.def+'</p>'+(u.note?'<p class="hint">'+u.note+'</p>':'')+'<div class="urows">';
  ["tank","dgt","sup"].forEach(function(r){
    var list = HEROES.filter(function(h){return h.role===r && h.utils[u.id];}).sort(byName);
    if(!list.length) return;
    html += '<h3 class="urole display r-'+r+'">'+ROLES[r]+'</h3>';
    list.forEach(function(h){
      var x = h.utils[u.id];
      html += '<div class="urow"><div>'+chip(h,1,x.q)+'</div><div class="why">'+x.why+'</div></div>';
    });
  });
  html += '</div>';
  document.getElementById("util-panel").innerHTML = html;
}

